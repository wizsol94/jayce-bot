# ─────────────────────────────────────────────────────────────
# PRICE ALERTS — example configuration
# Copy the values you need into .env. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Master switch. Nothing is constructed, no worker runs, no database
# file is created, and no network calls are made while this is false.
JACE_PRICE_ALERTS_ENABLED=false

# Telegram forum TOPIC that triggered alerts publish into.
# WizTheoryLabs is a forum group, so Price Alerts is a topic inside the
# same chat rather than a separate group. Find the ID in a message link:
#   https://t.me/c/<chat>/<TOPIC_ID>/<message>
# Resolved at send time, so moving the topic is a config change only.
# If missing or invalid, triggered alerts fall back to the General area.
JACE_PRICE_ALERT_TOPIC_ID=

# Dedicated SQLite file, deliberately separate from the scanner database
# so the worker thread cannot lock scanner/training data.
# MUST point at persistent storage on the VPS.
JACE_PRICE_ALERT_DB_PATH=/opt/jayce/data/jayce_alerts.db

# Seconds between price checks. Minimum 5, enforced in code.
# Each unique token is one DexScreener call per cycle, so raise this
# if the group creates many alerts across many tokens.
JACE_PRICE_ALERT_POLL_SECONDS=5

# Comma separated Telegram user IDs with admin rights over alerts.
# Admins can delete anyone's alert, run /clearalerts, and bypass the
# per-user cap. If unset, falls back to OWNER_USER_ID.
# Empty on both means NOBODY can clear or override.
JACE_PRICE_ALERT_ADMIN_IDS=

# Used as the admin fallback above, and as the DM recipient below.
OWNER_USER_ID=

# Optional best-effort DM copy of each triggered alert.
# A DM failure never affects the alert's delivery status.
JACE_PRICE_ALERT_DM_ENABLED=false
JACE_PRICE_ALERT_DM_USER_ID=

# Seconds to wait for a Telegram send before treating it as failed.
JACE_PRICE_ALERT_SEND_TIMEOUT=30

# NOT an environment variable: the per-user active alert cap is
# MAX_ACTIVE_PER_USER in jace/price_alerts/service.py (currently 10).
# Changing it requires a code edit, not a config change.

# ─────────────────────────────────────────────────────────────
# NEVER commit: bot tokens, GitHub PATs, .env itself, API keys,
# wallet keys, or any live credential. .env is gitignored — keep it
# that way. This file must contain placeholders only.
# ─────────────────────────────────────────────────────────────
